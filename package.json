{
  "name": "sentinelpay",
  "version": "0.1.0",
  "description": "Secure AI-to-Commerce policy gateway that validates AI agent purchase requests and executes them via the PayPal REST API.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "db:up": "docker compose up -d --wait",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:dist": "node dist/db/migrate-cli.js",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "sandbox:check": "tsx scripts/sandbox-check.ts",
    "sandbox:e2e": "tsx scripts/sandbox-e2e.ts",
    "db:app-role": "tsx src/cli/db-app-role.ts",
    "operator": "tsx src/cli/operator-cli.ts",
    "audit:keygen": "tsx src/cli/audit-keygen.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "vault:setup": "tsx scripts/vault-setup.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "ag-grid-community": "32.3.3",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
