# SentinelPay configuration. Copy to .env and replace every <placeholder>.
# The server validates all of this at startup and refuses to run if anything is wrong.

NODE_ENV=development
PORT=5000

# --- Database (required; there is no in-memory fallback) ----------------------
# Local: `npm run db:up` starts PostgreSQL 17 in Docker on 127.0.0.1:5433.
# MIGRATION_DATABASE_URL is the schema OWNER, used only by `npm run migrate` and `npm run db:app-role`.
MIGRATION_DATABASE_URL=postgresql://<owner-user>:<owner-password>@127.0.0.1:5433/sentinelpay
# DATABASE_URL is what the running app uses. Point it at the least-privilege runtime role:
# `npm run db:app-role -- --write-env` creates the role and fills this in for you.
# (In production the server refuses to start as a superuser or as the audit table owner.)
DATABASE_URL=postgresql://<app-role>:<app-role-password>@127.0.0.1:5433/sentinelpay
APP_DB_ROLE=sentinelpay_app

# --- Operator access -----------------------------------------------------------
# There is no shared admin secret. Each person gets a named key with a role
# (VIEWER, AUDITOR, OPERATOR, ADMIN), stored hashed in the database:
#   npm run operator -- create --id <you> --name "<Your Name>" --role ADMIN --out .secrets/<you>.key
# ADMIN_API_KEY is retired; setting it makes the server refuse to start.
AUTH_FAILURE_LIMIT_PER_MINUTE=10

# Exact browser origins allowed to call the API cross-origin, comma-separated.
# Leave empty when only the bundled dashboard (same origin) is used. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app. 0 = trust no X-Forwarded-For header.
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120
AGENT_PAYMENT_RATE_LIMIT_PER_MINUTE=30

# --- Audit integrity --------------------------------------------------------------
# Ed25519 key for signed audit checkpoints: `npm run audit:keygen -- --out .secrets/audit-signing`
# Keep the private key off the database host in production (or use a KMS/HSM signer).
AUDIT_SIGNING_KEY_FILE=<path-to-audit-signing.pem>
# Every checkpoint is appended here. In production use storage the DB admins cannot rewrite
# (e.g. object storage with retention lock / WORM). Verify independently with:
#   npm run audit:verify -- --public-key <audit-signing.pub.pem> --checkpoints <this file>
AUDIT_CHECKPOINT_FILE=<path-to-audit-checkpoints.jsonl>

# --- PayPal (SANDBOX ONLY) ----------------------------------------------------
# Sandbox app credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Never put live credentials here: the server refuses any PayPal host except
# https://api-m.sandbox.paypal.com.
PAYPAL_CLIENT_ID=<sandbox-client-id>
PAYPAL_CLIENT_SECRET=<sandbox-client-secret>
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional vaulted payment source. Obtain a PayPal vault id with buyer consent via
# `npm run vault:setup -- --write-env` (requires "Save payment methods" on the sandbox app).
# Configuring it does NOT make agents autonomous: each agent's autonomousLimit (default 0)
# decides which payments may skip buyer approval.
#   PAYPAL_VAULT_ID   -> payment_source.paypal.vault_id
#   BILLING_AGREEMENT -> payment_source.token { type: BILLING_AGREEMENT }
PAYPAL_VAULT_PAYMENT_TOKEN=
PAYPAL_VAULT_TOKEN_TYPE=

# Public URL of this server; PayPal returns the buyer here after approval.
# Defaults to http://localhost:$PORT
APP_BASE_URL=

# --- Demo AI agent (Google Gemini) -------------------------------------------
# Enables the in-app AI assistant (dashboard "Ask the purchasing agent") and `npm run demo:agent`.
# Server-side only; never sent to the browser. Without it the assistant reports itself unavailable.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash
# Assistant messages per operator per minute (each message can make several model calls).
ASSISTANT_RATE_LIMIT_PER_MINUTE=10

# --- Spending policy (USD) ----------------------------------------------------
# Global ceilings. Each agent also has its own (lower or equal) caps set via the admin API.
DAILY_SPENDING_CAP=100.00
PER_TRANSACTION_CAP=25.00
# Unapproved orders release their reserved budget after this long.
PENDING_APPROVAL_TTL_MINUTES=180
# In-flight PayPal calls untouched this long are flagged RECONCILE_REQUIRED (keep above 15).
STALE_IN_FLIGHT_SECONDS=120
SWEEP_INTERVAL_SECONDS=30
